{
  "name": "pawpawbi",
  "productName": "PawpawBI",
  "version": "1.0.0",
  "private": true,
  "description": "Build business intelligence reports from your data, with an assistant.",
  "keywords": [],
  "license": "MIT",
  "author": "Elliot",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "server:stub": "node scripts/pawpaw-server-stub.mjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "vue-tsc --noEmit",
    "setup:python": "node scripts/setup-python.mjs",
    "prestart": "npm run setup:python",
    "prepackage": "npm run setup:python",
    "premake": "npm run setup:python",
    "lock:python": "node scripts/setup-python.mjs --lock",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --experimental-strip-types --no-warnings --import ./tests/node/support/register.mjs --test \"tests/node/**/*.test.ts\"",
    "test:python": "node scripts/test-python.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.7.2",
    "oxfmt": "0.41.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "electron-squirrel-startup": "1.0.1",
    "vue": "3.5.44",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
